# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
DATABASE_URL=mongodb://localhost:27017/bactiveph
# Or for PostgreSQL/etc:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# API Keys
API_KEY=your_api_key_here
THIRD_PARTY_SERVICE_API_KEY=your_third_party_service_api_key_here

# Webhooks and Secrets
WEBHOOK_SECRET=your_webhook_secret_here
JWT_SECRET=your_jwt_secret_here

# Firebase Configuration (if applicable)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# cPanel Configuration
CPANEL_URL=https://premium343.web-hosting.com/cpanel
CPANEL_USER=your_cpanel_user_here
CPANEL_PASSWORD=your_cpanel_password_here
CPANEL_API_TOKEN=your_cpanel_api_token_here

# FTP Configuration
FTP_HOST=ftp.bactiveph.com
FTP_PORT=21
FTP_USER=bactive@bactiveph.com
FTP_PASSWORD=your_ftp_password_here

